{
  "info": {
    "_postman_id": "9cb5a0b6-d667-4b10-9e35-318cfaebac71",
    "name": "InstaBot API v1",
    "description": "Postman collection for the InstaBot Django API. Set baseUrl to the API root (default: http://localhost:8000/api/v1). Register or obtain a JWT, then use the token requests to populate accessToken and refreshToken. Most endpoints require a bearer access token. Proxy management requires a staff account; automation job submission also requires the Celery/Redis worker services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "username", "value": "u1" },
    { "key": "password", "value": "Password123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "accountId", "value": "1" },
    { "key": "proxyId", "value": "1" },
    { "key": "sessionId", "value": "1" },
    { "key": "analyticsId", "value": "1" },
    { "key": "actionLogId", "value": "1" },
    { "key": "behaviorId", "value": "1" },
    { "key": "downloadId", "value": "1" },
    { "key": "queueId", "value": "1" },
    { "key": "mediaFileId", "value": "1" },
    { "key": "jobId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "taskId", "value": "celery-task-id" },
    { "key": "exportJobId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"u1@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register/"
          },
          "response": []
        },
        {
          "name": "Obtain JWT token pair",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.access) pm.collectionVariables.set('accessToken', body.access);",
                  "  if (body.refresh) pm.collectionVariables.set('refreshToken', body.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/token/"
          },
          "response": []
        },
        {
          "name": "Refresh JWT token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.access) pm.collectionVariables.set('accessToken', body.access);",
                  "  if (body.refresh) pm.collectionVariables.set('refreshToken', body.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/token/refresh/"
          },
          "response": []
        },
        {
          "name": "Verify access token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/token/verify/"
          },
          "response": []
        }
      ]
    },
