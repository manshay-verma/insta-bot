    {
      "name": "Exports",
      "item": [
        {
          "name": "Create export",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (body.job_id) pm.collectionVariables.set('exportJobId', body.job_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"export_format\": \"json\",\n  \"data_types\": [\"analytics\", \"actions\", \"downloads\", \"media_files\", \"system_status\"]\n}",
